# LegalFlow Frontend Environment Variables

# The base URL of the deployed Express backend (Render URL in production, localhost in development)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Resend Email Configuration
# Mode: "sandbox" (default, routes to owner email upon 403 sandbox errors) or "production" (sends to raw recipient)
EMAIL_MODE=sandbox
# The verified sender email address on your Resend account (default onboarding sandbox address shown below)
RESEND_FROM_EMAIL="LegalFlow Notifications <onboarding@resend.dev>"
